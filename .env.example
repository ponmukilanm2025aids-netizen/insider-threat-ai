# AyurSutra Environment Configuration
# Ministry of AYUSH SIH25023 Problem Statement

# Application Settings
PROJECT_NAME="AyurSutra - Panchakarma Patient Management System"
API_V1_STR="/api/v1"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local PostgreSQL connection for backend started directly on this computer.
DATABASE_URL=postgresql+psycopg2://ayursutra_user:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/ayursutra_db

# Docker Compose uses these values to create/connect to its PostgreSQL container.
POSTGRES_USER=ayursutra_user
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=ayursutra_db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

